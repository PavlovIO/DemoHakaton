# Версии инструментов — единственный источник. Makefile читает через include,
# CI сливает в $GITHUB_ENV (grep '^[A-Z]' versions.env >> "$GITHUB_ENV").
# Dependabot этот файл не видит — поднимать руками.
GOLANGCI_LINT_VERSION=v2.15.0
LEFTHOOK_VERSION=v2.2.1
ACTIONLINT_VERSION=v1.7.12
GOOSE_VERSION=v3.29.0
SQLC_VERSION=1.31.1
VACUUM_VERSION=v0.33.2
OASDIFF_VERSION=v1.34.0
