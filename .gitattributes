# Normalize line endings
* text=auto
# Files that must stay LF (Linux shell, Make, SQL — не важно, но лучше единообразно)
Makefile    text eol=lf
*.sh        text eol=lf
*.sql       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
# Go: gofmt и sqlc (в Docker) пишут LF — иначе после make gen все файлы «изменены»
*.go        text eol=lf
go.mod      text eol=lf
go.sum      text eol=lf
# Windows scripts — CRLF
*.ps1       text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf
# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.pdf       binary
# Сгенерированный код (make gen): GitHub сворачивает его в диффах PR и не учитывает в статистике.
*.gen.go                               linguist-generated=true
backend/internal/repository/sqlc/*.go  linguist-generated=true
api/openapi.yaml                       linguist-generated=true
backend/internal/openapi/openapi.yaml  linguist-generated=true
