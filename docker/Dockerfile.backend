# Образ бэкенда (backend/cmd/server). Контекст сборки — корень репо (как у
# Dockerfile.frontend); что попадает в контекст — Dockerfile.backend.dockerignore рядом.
#   docker compose build backend     # или make backend-up
#
# Цели:
#   runtime    — сервер, по умолчанию;
#   seed-files — runtime + cmd/seedfiles и demo-PDF сида BE-16: кладёт их в volume
#                документов под тем же пользователем, что и сервер (make backend-seed-files).
# Миграции, санкции и SQL-сид в образ не входят — их применяет make db с хоста.

# Версия Go — из toolchain в backend/go.mod; GOTOOLCHAIN=local запрещает докачивать другую.
FROM golang:1.27.2-alpine AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY backend/ ./
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server && \
    go build -trimpath -ldflags="-s -w" -o /out/seedfiles ./cmd/seedfiles

# Alpine, а не distroless: healthcheck compose нужен wget из busybox.
FROM alpine:3.22 AS runtime
# Каталог документов создаётся с владельцем-сервером: named volume при первом монтировании
# наследует владельца и права 0700 (BE-05) из образа.
RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app && \
    install -d -o app -g app -m 0700 /var/lib/liquidity-platform/documents
COPY --from=build /out/server /usr/local/bin/server
USER app:app
ENV HTTP_ADDR=:8080 \
    LOG_FORMAT=json \
    DOCUMENT_STORAGE_DIR=/var/lib/liquidity-platform/documents
EXPOSE 8080
VOLUME ["/var/lib/liquidity-platform/documents"]
ENTRYPOINT ["/usr/local/bin/server"]

FROM runtime AS seed-files
COPY --from=build /out/seedfiles /usr/local/bin/seedfiles
COPY --chown=app:app backend/migrations/testdata/demo_files /usr/share/liquidity-platform/demo_files
ENTRYPOINT ["/usr/local/bin/seedfiles", "-manifest", "/usr/share/liquidity-platform/demo_files/manifest.txt", \
            "-dst", "/var/lib/liquidity-platform/documents"]
