# Образ фронтенда (frontend/): Vite-сборка → статика под nginx. Контекст сборки — корень
# репо, как у Dockerfile.backend; что попадает в контекст — Dockerfile.frontend.dockerignore.
#   docker compose build frontend    # или make frontend-up
#
# nginx отдаёт SPA и проксирует /api на бэкенд (как server.proxy в vite.config.ts): фронт
# и API на одном origin — cookie сессии ходит без CORS, CORS_ALLOWED_ORIGINS не нужен.

# Node — та же мажорная версия, что в CI (frontend.yml, setup-node).
FROM node:22.23.4-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY frontend/ ./
# tsc -b && vite build: типы проверяются и здесь, сломанный фронт образ не соберёт.
RUN npm run build

# nginx-unprivileged: процесс от uid 101 (nginx) и порт 8080 — без root внутри контейнера.
FROM nginxinc/nginx-unprivileged:1.29.8-alpine AS runtime
# Шаблон проходит envsubst при старте (entrypoint образа): подставляются только заданные
# переменные окружения, nginx-переменные вида $uri остаются как есть.
COPY docker/nginx.frontend.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist /usr/share/nginx/html
ENV BACKEND_URL=http://backend:8080
EXPOSE 8080
