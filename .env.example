POSTGRES_USER=lp
POSTGRES_PASSWORD=lp_dev_password
POSTGRES_DB=liquidity_platform
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgres://lp:lp_dev_password@localhost:5432/liquidity_platform?sslmode=disable

# Backend (cmd/server). Все, кроме DATABASE_URL, необязательны — ниже дефолты.
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=0
COOKIE_SECURE=false
SESSION_TTL=24h
# Каталог KYC-файлов вне веб-корня; должен переживать перезапуски. По умолчанию Makefile
# подставляет <репо>/storage/documents. Не оставляйте пустым: пустое значение отключит дефолт.
# DOCUMENT_STORAGE_DIR=/var/lib/liquidity-platform/documents
