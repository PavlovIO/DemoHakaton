# Суперпользователь контейнера — только для администрирования: make db-roles, make psql, сид, invariants.
POSTGRES_USER=lp
POSTGRES_PASSWORD=lp_dev_password
POSTGRES_DB=liquidity_platform
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Роли из backend/db/roles.sql (make db-roles). На стенде пароли — из секретов, не эти.
LP_APP_PASSWORD=lp_app_dev_password
LP_MIGRATOR_PASSWORD=lp_migrator_dev_password
# Приложение и интеграционные тесты — lp_app (только DML). На стенде добавить sslmode=require или verify-full.
DATABASE_URL=postgres://lp_app:lp_app_dev_password@localhost:5432/liquidity_platform?sslmode=disable
# Владелец схемы lp_migrator: goose (make migrate-*), загрузчик санкционных списков
# (make load-sanctions) и фикстуры интеграционных тестов, запрещённые lp_app; без него такие тесты пропускаются.
MIGRATE_DATABASE_URL=postgres://lp_migrator:lp_migrator_dev_password@localhost:5432/liquidity_platform?sslmode=disable

# Backend (cmd/server). Все, кроме DATABASE_URL, необязательны — ниже дефолты.
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=0
COOKIE_SECURE=false
SESSION_TTL=24h
# Origin фронта на другом хосте через запятую (scheme://host[:port], без пути). Пусто — CORS
# выключен: основной путь — фронт и API на одном origin (Vite proxy / reverse-proxy).
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# Каталог KYC-файлов вне веб-корня; должен переживать перезапуски. По умолчанию Makefile
# подставляет <репо>/storage/documents. Не оставляйте пустым: пустое значение отключит дефолт.
# DOCUMENT_STORAGE_DIR=/var/lib/liquidity-platform/documents

# Бэкенд в Docker (make backend-up): порт на хосте и, при необходимости, другая БД. Внутри сети
# compose Postgres доступен как postgres:5432 — DATABASE_URL выше с localhost там не подходит.
# BACKEND_PORT=8080
# BACKEND_DATABASE_URL=postgres://lp_app:lp_app_dev_password@postgres:5432/liquidity_platform?sslmode=disable

# Фронтенд в Docker (make frontend-up): порт на хосте; /api nginx проксирует на backend.
# FRONTEND_PORT=3000

# Публичный HTTPS-URL на приложение через ngrok (make tunnel-up): показать демо внешнему
# человеку. Токен — dashboard.ngrok.com → Your Authtoken; держите его только в .env, не в git.
# Пока туннель поднят, приложение открыто всему интернету — после проверки make tunnel-down.
# NGROK_AUTHTOKEN=
# Статический домен из дашборда ngrok (на free-плане один бесплатно); без него URL случайный.
# NGROK_DOMAIN=example.ngrok-free.app
# Порт веб-панели ngrok на хосте (только 127.0.0.1): URL туннеля и журнал запросов.
# NGROK_WEB_PORT=4040
